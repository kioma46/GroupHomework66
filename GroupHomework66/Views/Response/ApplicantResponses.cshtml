@model List<GroupHomework66.Models.Response>

@{
    ViewData["Title"] = "Мои отклики";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Мои отклики</h1>
            <p class="text-muted mb-0">Вакансии, на которые вы отправили резюме.</p>
        </div>
        <a asp-controller="Vacancy" asp-action="List" class="btn btn-primary">
            <i class="fa-solid fa-magnifying-glass me-2"></i>Найти вакансии
        </a>
    </div>
    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-light border text-center py-5">
            <i class="fa-regular fa-paper-plane fa-3x text-secondary mb-3"></i>
            <h4>Вы пока не откликались на вакансии</h4>
            <p class="text-muted">Найдите подходящую вакансию и отправьте работодателю одно из своих резюме.</p>
            <a asp-controller="Vacancy" asp-action="List" class="btn btn-primary">Перейти к вакансиям</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var response in Model)
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                            <div class="flex-grow-1">
                                @if (response.Vacancy != null && response.Vacancy.IsPublished)
                                {
                                    <h5 class="card-title mb-2">
                                        @response.Vacancy.Title
                                    </h5>
                                }
                                else
                                {
                                    <h5 class="card-title mb-2">@(response.Vacancy?.Title ?? "Вакансия недоступна")</h5>
                                }

                                <p class="text-muted mb-3">
                                    <i class="fa-regular fa-building me-1"></i>
                                    @(response.Vacancy?.Employer?.UserName ?? "Компания")
                                </p>
                            </div>
                            @if (response.Vacancy?.IsPublished == true)
                            {
                                <span class="badge bg-success">Вакансия опубликована</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Вакансия снята с публикации</span>
                            }
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="small text-muted">Резюме, отправленное работодателю</div>
                                <div class="fw-semibold">@(response.Resume?.Title ?? "Резюме недоступно")</div>
                            </div>
                            <div class="col-md-6">
                                <div class="small text-muted">Дата отклика</div>
                                <div>@response.ResponseDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                        </div>
                        <hr />
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            @if (response.Vacancy?.IsPublished == true)
                            {
                                <a asp-controller="Vacancy" asp-action="Details" asp-route-id="@response.VacancyId" class="btn btn-outline-primary btn-sm">
                                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Открыть вакансию
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
