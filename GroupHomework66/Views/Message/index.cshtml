@{
    ViewData["Title"] = "Чат";
}

<input type="hidden" id="candidateId" value="@ViewBag.CandidateId" />
<input type="hidden" id="employerId" value="@ViewBag.EmployerId" />

<div class="container mt-4">
    <h3>Чат</h3>
    <hr />
    
    <div class="border rounded p-3 mb-3 bg-light" id="scroll-message-container" style="height: 450px; overflow-y: auto;">
    </div>
    
    <div class="mx-auto" style="width: 100%">
        <form id="message-form" class="w-100 border p-3 rounded-3 bg-white shadow-sm">
            @Html.AntiForgeryToken()
            <div class="row w-100 g-2">
                <div class="col-10">
                    <textarea class="form-control w-100" rows="2" style="resize: none" id="message-textarea" placeholder="Введите сообщение (от 1 до 200 символов)..."></textarea>
                </div>
                <div class="col-2 d-flex align-items-center justify-content-center">
                    <button class="btn btn-primary w-100 h-100" type="submit">Отправить</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script>
        $(document).ready(function () {
            const candidateId = $('#candidateId').val();
            const employerId = $('#employerId').val();

            function loadMessages() {
                $.ajax({
                    url: '/Message/GetMessageAjax',
                    type: 'GET',
                    data: { candidateId: candidateId, employerId: employerId },
                    dataType: 'json',
                    success: function (data) {
                        const $container =$('#scroll-message-container');
                        $container.empty();

                        if (data.length === 0) {
                            $container.append('<p class="text-center text-muted">Нет сообщений. Напишите первое!</p>');
                            return;
                        }

                        data.forEach(element => {
                            let formattedDate = new Date(element.createdAt).toLocaleString();

                            $container.append(`
        <div class="mb-2 p-2 border rounded bg-white shadow-sm">
            <div class="d-flex justify-content-between text-muted small mb-1">
                <span>${element.senderUserName}</span>
                <span>${formattedDate}</span>
            </div>
            <p class="mb-0 text-break">${element.messageText}</p>
        </div>
    `);
                        });

                        $container.scrollTop($container[0].scrollHeight);
                    },
                    error: function (xhr) {
                        console.error("GetMessages Error:", xhr);
                    }
                });
            }

            $('#message-form').on('submit', function (e) {
                e.preventDefault();
                const text = $('#message-textarea').val().trim();

                if (text.length < 1 || text.length > 200) {
                    alert('Сообщение должно содержать от 1 до 200 символов.');
                    return;
                }

                const token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '/Message/SendMessageAjax',
                    type: 'POST',
                    headers: { "RequestVerificationToken": token },
                    data: {
                        messageText: text,
                        candidateId: candidateId,
                        employerId: employerId
                    },
                    success: function () {
                        $('#message-textarea').val('');
                        loadMessages();
                    },
                    error: function (xhr) {
                        alert(xhr.responseText || 'Ошибка при отправке сообщения.');
                    }
                });
            });

            loadMessages();
            setInterval(loadMessages, 5000);
        });
    </script>
}