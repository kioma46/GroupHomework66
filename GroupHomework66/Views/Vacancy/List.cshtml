@model List<GroupHomework66.Models.Vacancy>
@using System.Security.Claims
@using GroupHomework66.Enums
@using Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Список вакансий";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<h1 class="mb-4">Список вакансий</h1>
<form method="get" asp-action="List" class="card card-body bg-light mb-4 shadow-sm">
    <div class="row g-3">
        <div class="col-md-4">
            <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Поиск по названию..." />
        </div>
        <div class="col-md-3">
            <select name="category" class="form-select">
                <option value="">Все категории</option>
                @foreach (VacancyCategory category in Enum.GetValues(typeof(VacancyCategory)))
                {
                    <option value="@category" selected="@(ViewBag.CurrentCategory?.ToString() == category.ToString())">
                        @category.GetDisplayName()
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="sortBySalary" class="form-select">
                <option value="">Сортировка по зарплате</option>
                <option value="asc" selected="@(ViewBag.CurrentSort == "asc")">По возрастанию</option>
                <option value="desc" selected="@(ViewBag.CurrentSort == "desc")">По убыванию</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Найти</button>
            <a asp-action="List" class="btn btn-outline-secondary">Сброс</a>
        </div>
    </div>
</form>

@if (Model.Count <= 0)
{
    <p class="text-muted">Вакансии не найдены</p>
}
else
{
    foreach (var vacancy in Model)
    {
        var shortDescription = vacancy.Description.Length > 150
            ? vacancy.Description.Substring(0, 150) + "..."
            : vacancy.Description;

        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-2">@vacancy.Title</h5>
                <h6 class="card-subtitle mb-2 text-muted">
                    @vacancy.Category.GetDisplayName() · @vacancy.Salary.ToString("N0") сом
                </h6>
                <p class="card-text">@shortDescription</p>
                <p class="text-muted small mb-3">
                    Опыт: от @vacancy.ExperienceFrom до @vacancy.ExperienceTo лет ·
                    Обновлено: @vacancy.UpdatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </p>
                <div class="d-flex gap-2 flex-wrap align-items-center">
                    <a class="btn btn-outline-primary btn-sm" asp-controller="Vacancy" asp-action="Details" asp-route-id="@vacancy.Id">Подробнее</a>

                    <button class="btn btn-sm @(vacancy.IsRespondedByTheCurrentUser ? "btn-outline-secondary" : "btn-outline-primary") button-response-toggle"
                            type="button"
                            data-id="@vacancy.Id"
                            data-responded="@vacancy.IsRespondedByTheCurrentUser.ToString().ToLower()">
                        @(vacancy.IsRespondedByTheCurrentUser ? "Убрать отклик" : "Откликнуться")
                    </button>

                    @if (vacancy.IsRespondedByTheCurrentUser)
                    {
                        <a class="btn btn-sm btn-success button-chat"
                           asp-controller="Message"
                           asp-action="Index"
                           asp-route-candidateId="@currentUserId"
                           asp-route-employerId="@vacancy.EmployerId">
                            Чат с работодателем
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    @if (ViewBag.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link" 
                           asp-action="List" 
                           asp-route-page="@i" 
                           asp-route-search="@ViewBag.CurrentSearch" 
                           asp-route-category="@ViewBag.CurrentCategory" 
                           asp-route-sortBySalary="@ViewBag.CurrentSort">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

<!-- Модальное окно для выбора резюме -->
<div class="modal fade" id="responseModal" tabindex="-1" aria-labelledby="responseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="responseModalLabel">Выберите резюме для отклика</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalVacancyId" />
                <div class="mb-3">
                    <label for="resumeSelect" class="form-label">Ваши резюме</label>
                    <select class="form-select" id="resumeSelect" asp-items="ViewBag.UserResumes">
                        <option value="">-- Выберите резюме --</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                <button type="button" class="btn btn-primary" id="btnSubmitResponse">Отправить отклик</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
<script>
    $(document).ready(function () {
        let activeBtn = null;
        let responseModal = new bootstrap.Modal(document.getElementById('responseModal'));

        $(document).on('click', '.button-response-toggle', function () {
            activeBtn = $(this);
            let vacancyId = activeBtn.data('id');
            let isResponded = activeBtn.data('responded') === true || activeBtn.data('responded') === 'true';

            if (isResponded) {
                removeResponse(vacancyId);
            } else {
                $('#modalVacancyId').val(vacancyId);
                $('#resumeSelect').val('');
                responseModal.show();
            }
        });

        $('#btnSubmitResponse').on('click', function () {
            let vacancyId = $('#modalVacancyId').val();
            let resumeId = $('#resumeSelect').val();

            if (!resumeId) {
                alert('Пожалуйста, выберите резюме!');
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '/Response/Create',
                type: 'POST',
                headers: { 'RequestVerificationToken': token },
                data: { vacancyId: vacancyId, resumeId: resumeId },
                success: function () {
                    responseModal.hide();
                    location.reload();
                },
                error: function (xhr) {
                    alert(xhr.responseText || 'Ошибка при создании отклика.');
                }
            });
        });

        function removeResponse(vacancyId) {
            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '/Response/Remove',
                type: 'POST',
                headers: { 'RequestVerificationToken': token },
                data: { vacancyId: vacancyId },
                success: function () {
                    location.reload();
                },
                error: function (xhr) {
                    alert(xhr.responseText || 'Ошибка при удалении отклика.');
                }
            });
        }
    });
</script>
}