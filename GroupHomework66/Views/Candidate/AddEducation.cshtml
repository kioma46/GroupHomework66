@model GroupHomework66.ViewModels.CreateEducationViewModel

@{
    ViewData["Title"] = "Добавить образование";
}

<div class="container py-4">
    <h1 class="text-center mb-4">Добавить образование</h1>
    <div class="row justify-content-center">
        <form asp-action="AddEducation" method="post" class="col-12 col-md-8 col-lg-6 p-4 border rounded-3 bg-light">
            <input type="hidden" name="resumeId" value="@ViewBag.ResumeId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Institution" class="form-label"></label>
                <input asp-for="Institution" class="form-control" placeholder="Например, Кыргызский национальный университет" />
                <span asp-validation-for="Institution" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Specialty" class="form-label"></label>
                <input asp-for="Specialty" class="form-control" placeholder="Например, Программная инженерия" />
                <span asp-validation-for="Specialty" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Дополнительная информация об образовании"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger small"></span>
                <div class="form-text">Оставьте пустым, если вы ещё учитесь.</div>
            </div>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Добавить образование</button>
                <a asp-action="Details" asp-route-id="@ViewBag.ResumeId" class="btn btn-outline-secondary">Вернуться к резюме</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}